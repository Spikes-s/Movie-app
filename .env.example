# ==============================================================================
# VAULTSHARE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# JWT Secret for Session Authentication
JWT_SECRET="vaultshare-super-secret-jwt-key-2026"

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE API)
# ------------------------------------------------------------------------------
# Obtain from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# R2 Endpoint URL format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="vaultshare-production"
R2_PUBLIC_DOMAIN=""

# ------------------------------------------------------------------------------
# APPLICATION STORAGE LIMITS & DEFAULTS
# ------------------------------------------------------------------------------
# Max File Upload Size: 10 GB (10 * 1024 * 1024 * 1024 bytes)
MAX_FILE_SIZE_BYTES=10737418240
# Default User Storage Quota: 5 GB (5 * 1024 * 1024 * 1024 bytes)
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
# Maximum Concurrent Uploads Per User
MAX_CONCURRENT_UPLOADS=3
